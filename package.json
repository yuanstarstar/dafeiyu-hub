{
  "name": "@local/dafeiyu-hub",
  "version": "0.3.20",
  "private": true,
  "type": "module",
  "description": "大肥鱼：住在 B 站的 AI 住民。人设、记忆、情绪、厌倦、满足、关系、总线程、总控台、B 站动作桥、素材、项目库、视频创作投稿与直播辅助。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "bridge",
    "studio",
    "vendor",
    "templates",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ]
}
